{
  "name": "speckvue-finance-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Speckvue Finance, handling personal financial data, transactions, budgets, accounts, and core financial management operations.",
  "homepage": "https://github.com/speckvue/speckvue-finance-api#readme",
  "bugs": {
    "url": "https://github.com/speckvue/speckvue-finance-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speckvue/speckvue-finance-api.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "build": "npm run prisma:generate && nest build",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "commitlint": "commitlint",
    "db:deploy": "node scripts/migrate.cjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:up": "docker compose --env-file .env up -d --wait db",
    "dev": "nest start --watch",
    "docker:build": "docker compose --env-file .env build api",
    "docker:config": "docker compose --env-file .env config --quiet",
    "docker:down": "docker compose --env-file .env down",
    "docker:up": "docker compose --env-file .env up -d --build --wait",
    "docker:watch": "docker compose --env-file .env -f compose.yml -f compose.dev.yml up --build --watch",
    "env:setup": "node scripts/configure-local.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file .env up -d --wait db redis",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "openapi:generate": "node dist/scripts/openapi.js",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "start": "nest start",
    "start:prod": "node dist/src/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:browser": "npm run build && node scripts/test-database.cjs --browser",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --runInBand",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --coverage",
    "test:database": "node scripts/test-database.cjs",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects e2e --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --watch",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "mysql2": "3.24.6"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.10.0 <25",
    "npm": ">=11 <13"
  }
}
