# Central configuration for native, database-only Docker, and full Docker.
NODE_ENV=development
APP_NAME="Speckvue Finance API"
APP_HOST=127.0.0.1
APP_PORT=4000
APP_URL=http://localhost:4000
API_PREFIX=api
API_VERSION=1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT=16kb
REQUEST_TIMEOUT_MS=15000
TRUST_PROXY_CIDRS=
SWAGGER_ENABLED=true
SIGNUP_ENABLED=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_at_least_48_random_characters
SESSION_COOKIE_NAME=speckvue_finance_session
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1
AUTH_CONCURRENCY=4
# Native networking. URLs are derived and percent-encoded, never duplicated.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=speckvue_finance
POSTGRES_USER=speckvue_app
POSTGRES_PASSWORD=replace_with_random_runtime_password
POSTGRES_MIGRATION_USER=speckvue_migrator
POSTGRES_MIGRATION_PASSWORD=replace_with_random_migration_password
POSTGRES_ADMIN_USER=speckvue_admin
POSTGRES_ADMIN_PASSWORD=replace_with_random_admin_password
DATABASE_TLS=false
DATABASE_CA_FILE=
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
# Container-specific network mapping; credentials are unchanged.
DOCKER_APP_HOST=0.0.0.0
DOCKER_DATABASE_HOST=db
DOCKER_DATABASE_PORT=5432
DOCKER_BIND_HOST=127.0.0.1
NODE_IMAGE=node:24-bookworm-slim
POSTGRES_IMAGE=postgres:18.6-bookworm
DOCKER_API_IMAGE=speckvue-finance-api:local
DOCKER_RESTART_POLICY=unless-stopped
DOCKER_HEALTH_INTERVAL=10s
DOCKER_HEALTH_TIMEOUT=5s
DOCKER_HEALTH_START_PERIOD=45s
DOCKER_HEALTH_RETRIES=10
DOCKER_API_MEMORY=512m
DOCKER_API_CPUS=1.0
DOCKER_DB_MEMORY=512m
DOCKER_DB_CPUS=1.0
DOCKER_UID=10001
DOCKER_GID=10001

# Winston JSON console logs and rotating archives.
LOG_LEVEL=info
LOG_DIRECTORY=logs
LOG_FILE_ENABLED=true
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
DOCKER_LOG_DIRECTORY=/app/logs

# Redis credentials are injected at runtime, never used as image build arguments.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=replace_with_random_redis_password
REDIS_DATABASE=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_IMAGE=redis:8.10.2-alpine
REDIS_INTERNAL_PORT=6379
DOCKER_REDIS_HOST=redis
REDIS_MAX_MEMORY=128mb
DOCKER_REDIS_MEMORY=192m
DOCKER_REDIS_CPUS=0.5
REDIS_PORT=6379
REDIS_KEY_PREFIX=speckvue:api

# Optional build-time network proxies (excluded from final image configuration).
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,db,redis

# Development compilers need more memory than compiled production servers.
DOCKER_DEV_MEMORY=2g
DOCKER_DEV_CPUS=2.0
DEV_NODE_OPTIONS=--max-old-space-size=1536
